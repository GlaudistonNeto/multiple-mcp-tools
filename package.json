{
  "name": "multiple-mcp-tools",
  "version": "1.0.0",
  "description": "Multi-MCP Tools for VS Code - Process data with MongoDB, filesystem, and CSV tools",
  "type": "module",
  "scripts": {
    "start": "node --env-file .env src/index.ts",
    "dev": "node --watch --inspect --env-file .env src/index.ts",
    "langgraph:serve": "npx @langchain/langgraph-cli dev",
    "docker:infra:up": "docker compose up -d --wait",
    "docker:infra:down": "docker compose down",
    "docker:infra:cleanup": "docker compose down --volumes --remove-orphans && rm -rf storage",
    "docker:infra:logs": "docker compose logs -f",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "langchain",
    "mongodb",
    "filesystem",
    "csv",
    "openrouter"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.2.1",
  "dependencies": {
    "@langchain/core": "^0.3.29",
    "@langchain/langgraph": "^0.2.25",
    "@langchain/mcp-adapters": "^0.0.5",
    "@langchain/openai": "^0.3.16",
    "csvtojson": "^2.0.10",
    "fastify": "^5.2.1",
    "langchain": "^0.3.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/csvtojson": "^2.0.9",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0"
  }
}
